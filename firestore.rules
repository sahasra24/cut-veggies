rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // CHANGE THIS: emails of staff who can see and update orders
    function isStaff() {
      return request.auth != null
        && request.auth.token.email in ['owner@example.com', 'staff@example.com'];
    }

    match /settings/menu {
      allow read: if true;
      allow write: if isStaff();
    }

    match /orders/{id} {
      // Customers can place an order (checked so junk can't be saved)
      allow create: if request.resource.data.status == 'new'
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 20
        && request.resource.data.pickupDate is string
        && request.resource.data.pickupTime is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 40
        && request.resource.data.notes.size() <= 300
        && (!('total' in request.resource.data) || request.resource.data.total is number);

      // Anyone with the (random, unguessable) order link can see that one order
      allow get: if true;

      // Only staff can list all orders
      allow list: if isStaff();

      // Staff can change status; a customer can only cancel a still-new order
      allow update: if isStaff()
        || (resource.data.status == 'new'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));

      allow delete: if isStaff();
    }
  }
}
